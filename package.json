{
  "name": "hajj-umrah-chatbot",
  "version": "1.0.0",
  "description": "WhatsApp Chatbot for Hajj/Umrah Visa & Transport Services",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "start:eyries": "cmd /c \"set CLIENT_ID=default&& node src/index.js\"",
    "start:masarat": "cmd /c \"set CLIENT_ID=masarat_group&& node src/index.js\"",
    "start:six_sigma": "cmd /c \"set CLIENT_ID=six_sigma&& node src/index.js\"",
    "dev": "nodemon src/index.js"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "puppeteer": "^24.3.0",
    "puppeteer-core": "^24.43.1",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "whatsapp-web.js": "^1.34.7"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}
